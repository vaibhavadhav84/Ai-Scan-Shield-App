# Copy to backend/.env for local Python; to .env for Docker Compose.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./scanshield.db
CORS_ORIGINS=[]
ACCESS_MINUTES=30
REFRESH_DAYS=14
RATE_LIMIT=120
AUTH_RATE_LIMIT=15
SAFE_THRESHOLD=30
HIGH_THRESHOLD=70
# Empty means explicit rule baseline. Only load trusted artifacts.
MODEL_PATH=
# Optional local faster-whisper model directory; never a provider URL.
SPEECH_MODEL_PATH=
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=180
REPUTATION_PROVIDER=disabled
REPUTATION_API_KEY=
REPUTATION_NONCOMMERCIAL_USE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Docker-only: replace this placeholder locally before starting.
POSTGRES_PASSWORD=replace-with-a-random-local-password
